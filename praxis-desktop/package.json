{
  "name": "praxis-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first desktop assistant for capturing ideas, creating missions, and resolving contextual actions.",
  "author": "Praxis Project",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "electron-builder install-app-deps",
    "build:app": "tsc && vite build",
    "package": "npm run build:app && electron-builder",
    "package:win": "npm run build:app && electron-builder --win nsis --x64 -c.directories.output=release/win-x64/${version}",
    "package:win:arm64": "npm run build:app && electron-builder --win nsis --arm64 -c.directories.output=release/win-arm64/${version}",
    "package:win:all": "npm run build:app && electron-builder --win nsis --x64 --arm64 -c.directories.output=release/win-multi/${version}",
    "build": "npm run package",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:assistant": "node scripts/run-assistant-regression.mjs",
    "test:sync": "node scripts/run-sync-recovery-regression.mjs",
    "test:home-node-networking": "node scripts/run-home-node-networking-regression.mjs",
    "test": "npm run test:assistant && npm run test:sync",
    "calendar:google:preflight": "node scripts/google-calendar-preflight.mjs",
    "memory:reindex": "npm run build:app && electron dist-electron/main.js --memory-reindex",
    "memory:repair": "npm run build:app && electron dist-electron/main.js --memory-repair",
    "storage:check": "npm run build:app && electron dist-electron/main.js --storage-check",
    "skills:list": "npm run build:app && electron dist-electron/main.js --skills-list",
    "companion:snapshot": "npm run build:app && electron dist-electron/main.js --companion-snapshot",
    "rainmeter:snapshot": "npm run build:app && electron dist-electron/main.js --rainmeter-snapshot",
    "companion:command": "npm run build:app && electron dist-electron/main.js --companion-command \"what matters today\"",
    "repair:native": "electron-builder install-app-deps",
    "preview": "vite preview"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.0",
    "better-sqlite3": "^12.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
